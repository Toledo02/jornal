# O projeto usa Google Gemini (SDK google-genai).
# Chave gratuita em https://aistudio.google.com/apikey
LLM_API_KEY=sua-chave-gemini
LLM_MODEL=gemini-3.6-flash
LLM_TEMPERATURE=0.4

# Modelos tentados se o principal responder 503 (sobrecarga). Separados por vírgula.
LLM_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash

TELEGRAM_BOT_TOKEN=seu-token-do-botfather
TELEGRAM_CHAT_ID=seu-chat-id

# Jogos, horários e placares (football-data.org). Plano gratuito em
# https://www.football-data.org/client/register — sem ele a seção de futebol
# fica só com notícias.
FOOTBALL_DATA_TOKEN=

# Opcional. A AwesomeAPI é a última fonte da cadeia de cotações e responde 429 sem token
# em IPs de datacenter — o jornal funciona sem ela.
AWESOMEAPI_TOKEN=

# Compatibilidade: os nomes OPENAI_API_KEY / OPENAI_MODEL / OPENAI_TEMPERATURE ainda são
# aceitos (herança de quando o projeto usava OpenAI), mas os LLM_* têm precedência.
